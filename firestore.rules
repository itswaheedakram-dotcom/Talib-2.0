rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function mutualFollow(String uid, String otherUid) {
      return uid != otherUid
        && exists(/databases/$(database)/documents/users/$(uid)/following/$(otherUid))
        && exists(/databases/$(database)/documents/users/$(otherUid)/following/$(uid));
    }

    function isBlocked(String uid, String otherUid) {
      return exists(/databases/$(database)/documents/users/$(uid)/blockedUsers/$(otherUid));
    }

    function notBlocked(String uid, String otherUid) {
      return !isBlocked(uid, otherUid) && !isBlocked(otherUid, uid);
    }

    function isParticipant(List participants) {
      return signedIn()
        && participants.size() == 2
        && participants.hasAny([request.auth.uid]);
    }

    // Existing app data paths. Messaging is intentionally NOT covered
    // by a broad authenticated catch-all.
    match /users/{userId} {
      allow read, write: if signedIn();
      match /{subcollection}/{documentId} {
        allow read, write: if signedIn();
      }
    }

    match /posts/{postId} {
      allow read, write: if signedIn();
      match /comments/{commentId} {
        allow read, write: if signedIn();
      }
    }

    match /institutes/{instituteId} {
      allow read, write: if signedIn();
    }

    match /hostels/{hostelId} {
      allow read, write: if signedIn();
      match /reviews/{reviewId} {
        allow read, write: if signedIn();
      }
    }

    match /resources/{resourceId} {
      allow read, write: if signedIn();
    }

    match /reports/{reportId} {
      allow read, write: if signedIn();
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && resource.data.participants.hasAny([request.auth.uid]);

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && mutualFollow(
          request.resource.data.participants[0],
          request.resource.data.participants[1]
        )
        && notBlocked(
          request.resource.data.participants[0],
          request.resource.data.participants[1]
        );

      allow update: if signedIn()
        && isParticipant(resource.data.participants)
        && request.resource.data.participants == resource.data.participants
        && mutualFollow(
          resource.data.participants[0],
          resource.data.participants[1]
        );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        )
        && notBlocked(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0],
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[1]
        );

        allow create: if signedIn()
          && isParticipant(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          )
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.receiverId in
             get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && mutualFollow(
            request.resource.data.senderId,
            request.resource.data.receiverId
          )
          && notBlocked(
            request.resource.data.senderId,
            request.resource.data.receiverId
          )
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;

        allow update: if signedIn()
          && resource.data.receiverId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.receiverId == resource.data.receiverId
          && request.resource.data.text == resource.data.text
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;

        allow delete: if false;
      }
    }
  }
}