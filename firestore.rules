rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function managerAdminPermission(permission) {
      return signedIn()
        && exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.role == 'manager_admin'
        && get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.permissions[permission] == true;
    }
    function hostelOwner() { return signedIn() && resource.data.ownerId == request.auth.uid; }
    function mutualFollow(uid, otherUid) {
      return uid != otherUid
        && exists(/databases/$(database)/documents/users/$(uid)/following/$(otherUid))
        && exists(/databases/$(database)/documents/users/$(otherUid)/following/$(uid));
    }
    function isBlocked(uid, otherUid) {
      return exists(/databases/$(database)/documents/users/$(uid)/blockedUsers/$(otherUid));
    }
    function notBlocked(uid, otherUid) {
      return !isBlocked(uid, otherUid) && !isBlocked(otherUid, uid);
    }
    function isParticipant(participants) {
      return signedIn() && participants.size() == 2 && participants.hasAny([request.auth.uid]);
    }
    function canManageInstitute(instituteId) {
      return signedIn() && (get(/databases/$(database)/documents/institutes/$(instituteId)).data.ownerId == request.auth.uid
        || managerAdminPermission('manage_institutes') || admin());
    }

    function validInstituteScore(data) {
      return data.get('minScore', 0) is number && data.get('minScore', 0) >= 0
        && (data.get('minScore', 0) == 0
          || (data.get('scoreScale', 'unspecified') == 'percentage' && data.minScore <= 100)
          || (data.get('scoreScale', 'unspecified') == 'cgpa4' && data.minScore <= 4)
          || (data.get('scoreScale', 'unspecified') == 'cgpa5' && data.minScore <= 5));
    }

    // Required for collection-group discovery; unpublished data is never public.
    match /{path=**}/opportunities/{opportunityId} {
      allow read: if resource.data.published == true;
    }

    match /{path=**}/instituteReviews/{reviewId} {
      allow read: if resource.data.published == true;
    }

    match /locationCatalog/{locationId} {
      allow read: if resource.data.enabled == true || admin() || managerAdminPermission('manage_institutes');
      allow create, update, delete: if admin() || managerAdminPermission('manage_institutes');
    }

    match /adminRoles/{adminUid} {
      allow read: if admin() || (signedIn() && request.auth.uid == adminUid);
      allow create, update, delete: if admin();
    }

    match /adminAuditLogs/{logId} {
      allow read: if admin() || managerAdminPermission('view_audit_logs');
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && (admin() || managerAdminPermission('view_audit_logs'));
      allow update, delete: if false;
    }

    function selectedAffiliationValid(data, userId) {
      let instituteId = data.get('studentInstituteId', '');
      let course = data.get('studentProgram', '');
      return (instituteId == '' && course == '' && data.get('studentVerificationStatus', '') == 'not_requested') || instituteId != '' && (
        (data.get('studentVerificationStatus', '') == 'pending'
          && getAfter(/databases/$(database)/documents/institutes/$(instituteId)/studentAffiliations/$(userId)).data.status == 'pending'
          && getAfter(/databases/$(database)/documents/institutes/$(instituteId)/studentAffiliations/$(userId)).data.program == course)
        || (course == '' && data.get('studentVerificationStatus', '') == 'not_requested'
          && !existsAfter(/databases/$(database)/documents/institutes/$(instituteId)/studentAffiliations/$(userId)))
      );
    }

    function validUsernameClaim(data, userId) {
      let username = data.get('username', '');
      return username.matches('^[a-z][a-z0-9_]{2,23}$')
        && getAfter(/databases/$(database)/documents/usernames/$(username)).data.uid == userId;
    }
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && username.matches('^[a-z][a-z0-9_]{2,23}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && (!exists(/databases/$(database)/documents/usernames/$(username)) || resource.data.uid == request.auth.uid)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', '') != username;
    }

    function educationShape(data, userId, recordId) {
      return data.keys().hasOnly(['educationRecordId', 'userId', 'instituteId', 'instituteName',
        'programId', 'program', 'educationLevelId', 'educationStatus', 'verificationStatus',
        'isPrimary', 'startDate', 'completionDate', 'createdAt', 'updatedAt'])
        && data.educationRecordId == recordId && data.userId == userId
        && data.instituteId is string && data.instituteId.size() > 0
        && data.instituteName == get(/databases/$(database)/documents/institutes/$(data.instituteId)).data.name
        && data.programId is string && data.program is string && data.program.size() <= 200
        && data.educationLevelId in ['school', 'college', 'diploma', 'bachelors', 'masters', 'doctorate', 'other']
        && data.educationStatus in ['current', 'completed', 'left']
        && data.verificationStatus in ['not_requested', 'pending', 'approved', 'rejected']
        && data.isPrimary is bool
        && (data.isPrimary || !existsAfter(/databases/$(database)/documents/users/$(userId)/private/educationState)
          || getAfter(/databases/$(database)/documents/users/$(userId)/private/educationState).data.primaryEducationRecordId != recordId)
        && (!data.isPrimary || (data.educationStatus == 'current'
          && getAfter(/databases/$(database)/documents/users/$(userId)/private/educationState).data.primaryEducationRecordId == recordId))
        && (data.startDate == null || data.startDate is timestamp && data.startDate <= request.time)
        && (data.completionDate == null || data.completionDate is timestamp && data.completionDate <= request.time)
        && (data.startDate == null || data.completionDate == null || data.completionDate >= data.startDate)
        && (data.educationStatus != 'current' || data.completionDate == null)
        && data.createdAt is timestamp && data.updatedAt == request.time
        && get(/databases/$(database)/documents/institutes/$(data.instituteId)).data.status in ['approved', 'verified'];
    }
    function educationMembershipData(data) {
      return {'educationRecordId': data.educationRecordId, 'userId': data.userId, 'instituteId': data.instituteId,
        'educationStatus': data.educationStatus, 'verificationStatus': data.verificationStatus};
    }
    function educationMembershipMatches(data) {
      return getAfter(/databases/$(database)/documents/institutes/$(data.instituteId)/educationMemberships/$(data.educationRecordId)).data
        == {'educationRecordId': data.educationRecordId, 'userId': data.userId, 'instituteId': data.instituteId,
          'educationStatus': data.educationStatus, 'verificationStatus': data.verificationStatus};
    }
    function educationStudentCreate(data, userId, recordId) {
      return signedIn() && request.auth.uid == userId && educationShape(data, userId, recordId)
        && data.createdAt == request.time
        && (data.verificationStatus == (data.educationStatus == 'current' && data.program != '' ? 'pending' : 'not_requested')
          || (recordId == 'legacy-' + userId && data.educationStatus == 'current' && data.verificationStatus == 'approved'
            && get(/databases/$(database)/documents/users/$(userId)).data.studentInstituteId == data.instituteId
            && get(/databases/$(database)/documents/users/$(userId)).data.studentProgram == data.program
            && get(/databases/$(database)/documents/institutes/$(data.instituteId)/studentAffiliations/$(userId)).data.status == 'approved'));
    }
    function educationStudentUpdate(data, old, userId, recordId) {
      return signedIn() && request.auth.uid == userId && educationShape(data, userId, recordId)
        && data.createdAt == old.createdAt
        && ((data.instituteId == old.instituteId && data.program == old.program && data.programId == old.programId && data.educationLevelId == old.educationLevelId && data.educationStatus == old.educationStatus
            && data.verificationStatus == old.verificationStatus)
          || data.verificationStatus == (data.educationStatus == 'current' && data.program != '' ? 'pending' : 'not_requested'));
    }
    function educationReview(data, old) {
      return canManageInstitute(old.instituteId) && old.educationStatus == 'current'
        && old.verificationStatus == 'pending' && data.verificationStatus in ['approved', 'rejected']
        && data.updatedAt == request.time
        && data.diff(old).affectedKeys().hasOnly(['verificationStatus', 'updatedAt']);
    }

    function accountVerificationCategory(category) {
      return category in ['official_team','institute_representative','education_professional','hostel_representative','public_figure','organization'];
    }
    match /accountVerifications/{userId} {
      allow read: if signedIn();
      allow create, update: if admin()
        && exists(/databases/$(database)/documents/users/$(userId))
        && request.resource.data.keys().hasOnly(['status','category','verifiedAt','updatedAt','auditId'])
        && request.resource.data.status in ['verified','revoked']
        && (request.resource.data.status != 'revoked' || (exists(/databases/$(database)/documents/accountVerifications/$(userId))
          && resource.data.status == 'verified' && request.resource.data.category == resource.data.category
          && request.resource.data.verifiedAt == resource.data.verifiedAt))
        && accountVerificationCategory(request.resource.data.category)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.verifiedAt is timestamp
        && (request.resource.data.status != 'verified' || request.resource.data.verifiedAt == request.time)
        && request.resource.data.auditId is string
        && existsAfter(/databases/$(database)/documents/accountVerificationAudits/$(request.resource.data.auditId))
        && getAfter(/databases/$(database)/documents/accountVerificationAudits/$(request.resource.data.auditId)).data.targetUid == userId
        && getAfter(/databases/$(database)/documents/accountVerificationAudits/$(request.resource.data.auditId)).data.actorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/accountVerificationAudits/$(request.resource.data.auditId)).data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/accountVerificationAudits/$(request.resource.data.auditId)).data.category == request.resource.data.category
        && getAfter(/databases/$(database)/documents/accountVerificationAudits/$(request.resource.data.auditId)).data.action == (request.resource.data.status == 'verified' ? 'verify' : 'revoke');
      allow delete: if false;
    }
    match /searchCatalogs/{catalogId} {
      allow read: if admin() || resource.data.enabled == true;
      allow create, update: if admin()
        && catalogId.matches('^[a-z][a-z0-9_-]{1,39}$')
        && request.resource.data.keys().hasOnly(['label','icon','aliases','facets','enabled','updatedAt'])
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0 && request.resource.data.label.size() <= 80
        && request.resource.data.icon is string
        && request.resource.data.aliases is list && request.resource.data.aliases.size() <= 30
        && request.resource.data.facets is list && request.resource.data.facets.size() <= 12
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }
    match /catalogItems/{itemId} {
      allow read: if admin() || (resource.data.published == true
        && get(/databases/$(database)/documents/searchCatalogs/$(resource.data.catalogId)).data.enabled == true);
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['catalogId','title','description','city','area','tags','attributes','published','updatedAt'])
        && request.resource.data.catalogId is string
        && exists(/databases/$(database)/documents/searchCatalogs/$(request.resource.data.catalogId))
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && request.resource.data.description is string && request.resource.data.description.size() <= 6000
        && request.resource.data.city is string && request.resource.data.area is string
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 50
        && request.resource.data.attributes is map && request.resource.data.attributes.size() <= 100
        && request.resource.data.published is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }

    match /accountVerificationAudits/{auditId} {
      allow read: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['targetUid','actorUid','action','category','reason','createdAt','previousStatus'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action in ['verify','revoke']
        && accountVerificationCategory(request.resource.data.category)
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 10 && request.resource.data.reason.size() <= 1000
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/accountVerifications/$(request.resource.data.targetUid)).data.auditId == auditId;
      allow update, delete: if false;
    }

    match /users/{userId} {
      // Authenticated users may view profiles, but may only change their own profile.
      // Admin tools may update only the representative fields needed after a verified claim.
      allow read: if signedIn() && (request.auth.uid == userId || admin()
        || resource.data.get('privateProfile', false) != true
        || (resource.data.get('studentInstituteId', '') != '' && canManageInstitute(resource.data.studentInstituteId)));
      allow create: if (signedIn() && request.auth.uid == userId
          && request.resource.data.get('uid', userId) == userId
          && (request.resource.data.get('username', '') == '' || validUsernameClaim(request.resource.data, userId))
          && request.resource.data.get('studentVerificationStatus', 'not_requested') != 'approved')
        || admin()
        || (managerAdminPermission('ownership_claim_review')
          && request.resource.data.keys().hasOnly([
            'role', 'instituteAdmin', 'instituteId', 'instituteName', 'designation'
          ]));
      allow delete: if signedIn() && request.auth.uid == userId || admin();
      allow update: if (signedIn() && request.auth.uid == userId
          && request.resource.data.get('uid', userId) == userId
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['username']) || (
            validUsernameClaim(request.resource.data, userId)
            && (resource.data.get('username', '') == ''
              || resource.data.get('username', '') == request.resource.data.username
              || !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username)))
          ))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'studentInstituteId', 'studentInstituteName', 'studentProgram', 'studentVerificationStatus'
          ]) || (
            selectedAffiliationValid(request.resource.data, userId)
            && (resource.data.get('studentInstituteId', '') == request.resource.data.studentInstituteId
              || resource.data.get('studentInstituteId', '') == ''
              || !existsAfter(/databases/$(database)/documents/institutes/$(resource.data.studentInstituteId)/studentAffiliations/$(userId)))
          ))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentVerificationStatus'])
            || request.resource.data.studentVerificationStatus in ['pending', 'not_requested']))
        || admin()
        || (managerAdminPermission('ownership_claim_review')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role', 'instituteAdmin', 'instituteId', 'instituteName', 'designation'
          ]));

      match /educationRecords/{recordId} {
        allow read: if signedIn() && (request.auth.uid == userId
          || get(/databases/$(database)/documents/users/$(userId)).data.get('privateProfile', false) != true
          || canManageInstitute(resource.data.instituteId));
        allow create: if educationStudentCreate(request.resource.data, userId, recordId)
          && getAfter(/databases/$(database)/documents/institutes/$(request.resource.data.instituteId)/educationRecords/$(recordId)).data == request.resource.data
          && educationMembershipMatches(request.resource.data);
        allow update: if (educationStudentUpdate(request.resource.data, resource.data, userId, recordId)
            || educationReview(request.resource.data, resource.data))
          && educationMembershipMatches(request.resource.data)
          && getAfter(/databases/$(database)/documents/institutes/$(request.resource.data.instituteId)/educationRecords/$(recordId)).data == request.resource.data
          && (request.resource.data.instituteId == resource.data.instituteId
            || (!existsAfter(/databases/$(database)/documents/institutes/$(resource.data.instituteId)/educationRecords/$(recordId))
              && !existsAfter(/databases/$(database)/documents/institutes/$(resource.data.instituteId)/educationMemberships/$(recordId))));
      }

      match /private/{documentId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if signedIn() && request.auth.uid == userId && (documentId != 'educationState'
          || (request.resource.data.keys().hasOnly(['primaryEducationRecordId'])
            && request.resource.data.primaryEducationRecordId is string
            && (request.resource.data.primaryEducationRecordId == ''
              || getAfter(/databases/$(database)/documents/users/$(userId)/educationRecords/$(request.resource.data.primaryEducationRecordId)).data.isPrimary == true)
            && (!exists(/databases/$(database)/documents/users/$(userId)/private/educationState)
              || resource.data.primaryEducationRecordId == ''
              || resource.data.primaryEducationRecordId == request.resource.data.primaryEducationRecordId
              || getAfter(/databases/$(database)/documents/users/$(userId)/educationRecords/$(resource.data.primaryEducationRecordId)).data.isPrimary == false)));
      }
      match /bookmarks/{postId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
      match /instituteBookmarks/{instituteId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
      match /timelineTopics/{topicId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
      match /blockedUsers/{blockedUid} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
      match /hiddenPosts/{postId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['postId','title','reason','createdAt'])
          && request.resource.data.postId == postId
          && request.resource.data.title is string && request.resource.data.title.size() <= 140
          && request.resource.data.reason in ['hide','not_interested']
          && request.resource.data.createdAt == request.time;
      }
      match /mutedAuthors/{authorId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.auth.uid == userId && authorId != userId
          && request.resource.data.keys().hasOnly(['authorId','name','createdAt'])
          && request.resource.data.authorId == authorId
          && request.resource.data.name is string && request.resource.data.name.size() <= 200
          && request.resource.data.createdAt == request.time;
      }
      match /following/{targetUid} {
        allow read: if signedIn() && (request.auth.uid == userId || request.auth.uid == targetUid);
        allow create: if signedIn() && request.auth.uid == userId
          && targetUid != userId
          && request.resource.data.userId == targetUid;
        allow delete: if signedIn()
          && (request.auth.uid == userId || request.auth.uid == targetUid);
        allow update: if false;
      }
      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == followerUid
          && request.resource.data.userId == request.auth.uid;
        // Either the follower or the profile owner can remove this relationship.
        allow delete: if signedIn()
          && (request.auth.uid == followerUid || request.auth.uid == userId);
        allow update: if false;
      }
      match /notifications/{notificationId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        // Recipients can only mark their own notification as read.
        allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow create: if signedIn()
          && (request.resource.data.fromId == request.auth.uid || admin());
      }

      match /reviews/{reviewerId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && reviewerId == request.auth.uid
          && reviewerId != userId
          && request.resource.data.reviewerId == request.auth.uid
          && request.resource.data.reviewerName is string
          && request.resource.data.reviewerName.size() <= 100
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt is timestamp
          && request.resource.data.keys().hasOnly([
            'reviewerId', 'reviewerName', 'rating', 'text', 'createdAt'
          ]);
        // A reviewer may edit/replace only their own review; the profile owner
        // cannot rewrite the reviewer's identity or rating on their behalf.
        allow update: if signedIn()
          && reviewerId == request.auth.uid
          && reviewerId != userId
          && resource.data.reviewerId == request.auth.uid
          && request.resource.data.reviewerId == resource.data.reviewerId
          && request.resource.data.reviewerName is string
          && request.resource.data.reviewerName.size() <= 100
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt is timestamp
          && request.resource.data.keys().hasOnly([
            'reviewerId', 'reviewerName', 'rating', 'text', 'createdAt'
          ]);
        allow delete: if signedIn()
          && reviewerId == request.auth.uid
          && reviewerId != userId;
      }
    }
    match /posts/{postId} {
      function validEducationField(data, key) {
        return data.get(key, '') is string && data.get(key, '').size() <= 600;
      }
      function validEducation(data) {
        return data is map && data.keys().hasOnly(['subject','program','topic','semester','deadline','eligibility','sourceUrl','coverage','mode','schedule','time','location','milestone','duration','purpose','field','organization'])
          && validEducationField(data, 'subject') && validEducationField(data, 'program')
          && validEducationField(data, 'topic') && validEducationField(data, 'semester')
          && validEducationField(data, 'deadline') && validEducationField(data, 'eligibility')
          && validEducationField(data, 'sourceUrl') && validEducationField(data, 'coverage')
          && validEducationField(data, 'mode') && validEducationField(data, 'schedule')
          && validEducationField(data, 'time') && validEducationField(data, 'location')
          && validEducationField(data, 'milestone') && validEducationField(data, 'duration')
          && validEducationField(data, 'purpose') && validEducationField(data, 'field')
          && validEducationField(data, 'organization');
      }
      function attachmentAt(data, index) {
        return index >= data.size() || (data[index] is map
          && data[index].type in ['photo','file','link']
          && data[index].name is string && data[index].name.size() <= 200
          && data[index].url is string && data[index].url.size() <= 4000
          && data[index].url.matches('https?://.*'));
      }
      function validContent(data) {
        return data.text is string && data.text.size() > 0 && data.text.size() <= 10000
          && data.authorName is string && data.authorName.size() <= 200
          && data.category is string && data.category.size() <= 100
          && data.get('postType', 'general') in ['general','question','resource','admission','scholarship','study_group','assignment','achievement','poll','career']
          && validEducation(data.get('educationalData', {}))
          && data.get('tags', []) is list && data.get('tags', []).size() <= 12
          && data.get('instituteIds', []) is list && data.get('instituteIds', []).size() <= 10
          && data.isQuestion is bool
          && data.get('attachments', []) is list && data.get('attachments', []).size() <= 8
          && attachmentAt(data.get('attachments', []), 0) && attachmentAt(data.get('attachments', []), 1)
          && attachmentAt(data.get('attachments', []), 2) && attachmentAt(data.get('attachments', []), 3)
          && attachmentAt(data.get('attachments', []), 4) && attachmentAt(data.get('attachments', []), 5)
          && attachmentAt(data.get('attachments', []), 6) && attachmentAt(data.get('attachments', []), 7)
          && data.get('pollOptions', []) is list
          && (data.get('pollOptions', []).size() == 0 || (data.pollOptions.size() >= 2 && data.pollOptions.size() <= 5))
          && (data.get('pollClosesAt', null) == null || data.pollClosesAt is timestamp);
      }
      function ownReactorIds() {
        let before = resource.data.get('likedBy', []);
        let after = request.resource.data.get('likedBy', []);
        return before is list && after is list && after.toSet().size() == after.size()
          && after.toSet().difference(before.toSet()).hasOnly([request.auth.uid])
          && before.toSet().difference(after.toSet()).hasOnly([request.auth.uid])
          && request.resource.data.likesCount == after.size();
      }
      function validReactionUpdate() {
        let before = resource.data.get('reactions', {});
        let after = request.resource.data.get('reactions', {});
        let choice = after.get(request.auth.uid, null);
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions','likedBy','likesCount'])
          && before is map && after is map
          && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
          && (choice == null || choice in ['like','insightful','helpful','celebrate','support'])
          && ownReactorIds()
          && ((choice != null) == request.resource.data.likedBy.hasAny([request.auth.uid]));
      }
      function validLegacyLike() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy','likesCount'])
          && resource.data.get('reactions', {}).get(request.auth.uid, null) == null
          && ownReactorIds()
          && (resource.data.likedBy.hasAny([request.auth.uid]) != request.resource.data.likedBy.hasAny([request.auth.uid]));
      }
      function pollHasVotes() {
        let votes = resource.data.get('pollVotes', {});
        return resource.data.get('pollVoters', {}).size() > 0
          || votes.get('0', 0) + votes.get('1', 0) + votes.get('2', 0) + votes.get('3', 0) + votes.get('4', 0) > 0;
      }
      function voteCount(key) {
        let oldChoice = resource.data.get('pollVoters', {}).get(request.auth.uid, -1);
        let choice = request.resource.data.pollVoters[request.auth.uid];
        let expected = resource.data.get('pollVotes', {}).get(key, 0)
          - (oldChoice == int(key) ? 1 : 0) + (choice == int(key) ? 1 : 0);
        return request.resource.data.pollVotes.get(key, 0) == expected && expected >= 0;
      }
      function validVote() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pollVotes','pollVoters'])
          && resource.data.get('pollOptions', []).size() >= 2
          && (resource.data.get('pollClosesAt', null) == null || request.time < resource.data.pollClosesAt)
          && request.resource.data.pollVoters is map
          && request.resource.data.pollVoters.diff(resource.data.get('pollVoters', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.pollVoters[request.auth.uid] is int
          && request.resource.data.pollVoters[request.auth.uid] >= 0
          && request.resource.data.pollVoters[request.auth.uid] < resource.data.pollOptions.size()
          && request.resource.data.pollVotes is map
          && request.resource.data.pollVotes.keys().hasOnly(['0','1','2','3','4'])
          && voteCount('0') && voteCount('1') && voteCount('2') && voteCount('3') && voteCount('4');
      }
      function validCommentCounter() {
        let id = request.resource.data.get('lastCommentId', '');
        let path = /databases/$(database)/documents/posts/$(postId)/comments/$(id);
        return id is string && id.size() > 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount','lastCommentId','bestAnswerId'])
          && request.resource.data.commentsCount is int && request.resource.data.commentsCount >= 0
          && ((!exists(path) && existsAfter(path)
              && getAfter(path).data.authorId == request.auth.uid
              && request.resource.data.commentsCount == resource.data.commentsCount + 1
              && request.resource.data.get('bestAnswerId', null) == resource.data.get('bestAnswerId', null))
            || (exists(path) && !existsAfter(path)
              && (get(path).data.authorId == request.auth.uid || admin())
              && request.resource.data.commentsCount == (resource.data.commentsCount > 0 ? resource.data.commentsCount - 1 : 0)
              && (request.resource.data.get('bestAnswerId', null) == resource.data.get('bestAnswerId', null)
                || (resource.data.get('bestAnswerId', null) == id && request.resource.data.get('bestAnswerId', null) == null))));
      }
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid
        && validContent(request.resource.data) && request.resource.data.createdAt == request.time
        && request.resource.data.likesCount == 0 && request.resource.data.likedBy == []
        && request.resource.data.get('reactions', {}) == {}
        && request.resource.data.commentsCount == 0
        && request.resource.data.get('pollVotes', {}) == {} && request.resource.data.get('pollVoters', {}) == {}
        && request.resource.data.get('bestAnswerId', null) == null
        && (request.resource.data.get('pollClosesAt', null) == null
          || (request.resource.data.pollClosesAt > request.time && request.resource.data.pollClosesAt < request.time + duration.value(8, 'd')))
        && request.resource.data.keys().hasOnly(['text','authorId','authorName','category','tags','instituteIds','isQuestion','createdAt','likesCount','likedBy','commentsCount','pollOptions','pollVotes','pollVoters','attachments','instituteId','postType','educationalData','reactions','pollClosesAt','bestAnswerId']);
      allow update: if signedIn() && (
        (resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','category','tags','instituteIds','isQuestion','pollOptions','attachments','instituteId','bestAnswerId','postType','educationalData','pollClosesAt','updatedAt'])
          && validContent(request.resource.data)
          && (request.resource.data.get('updatedAt', null) == resource.data.get('updatedAt', null) || request.resource.data.updatedAt == request.time)
          && (!pollHasVotes() || (request.resource.data.pollOptions == resource.data.pollOptions
            && request.resource.data.get('pollClosesAt', null) == resource.data.get('pollClosesAt', null)
            && request.resource.data.get('postType', 'general') == resource.data.get('postType', 'general')))
          && (request.resource.data.get('bestAnswerId', null) == resource.data.get('bestAnswerId', null)
            || request.resource.data.get('bestAnswerId', null) == null
            || (request.resource.data.isQuestion == true
              && exists(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.bestAnswerId)))))
        || validReactionUpdate() || validLegacyLike() || validCommentCounter() || validVote());
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || admin());
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 5000
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['text','authorId','authorName','createdAt'])
          && getAfter(/databases/$(database)/documents/posts/$(postId)).data.lastCommentId == commentId
          && getAfter(/databases/$(database)/documents/posts/$(postId)).data.commentsCount == get(/databases/$(database)/documents/posts/$(postId)).data.commentsCount + 1;
        allow update: if false;
        allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || admin())
          && getAfter(/databases/$(database)/documents/posts/$(postId)).data.lastCommentId == commentId
          && getAfter(/databases/$(database)/documents/posts/$(postId)).data.commentsCount == (get(/databases/$(database)/documents/posts/$(postId)).data.commentsCount > 0 ? get(/databases/$(database)/documents/posts/$(postId)).data.commentsCount - 1 : 0)
          && (get(/databases/$(database)/documents/posts/$(postId)).data.get('bestAnswerId', null) != commentId || getAfter(/databases/$(database)/documents/posts/$(postId)).data.get('bestAnswerId', null) == null);
      }
    }

    match /institutes/{instituteId} {
      allow read: if resource.data.status in ['approved', 'verified']
        || admin()
        || managerAdminPermission('manage_institutes')
        || (signedIn() && (
          resource.data.ownerId == request.auth.uid
          || resource.data.createdBy == request.auth.uid
        ));

      allow create: if (signedIn()
          && request.resource.data.status == 'pending'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.ownerId == ''
          && validInstituteScore(request.resource.data))
        || (admin()
          || managerAdminPermission('ownership_claim_review'))
          && request.resource.data.status == 'approved'
          && request.resource.data.ownerId is string
          && request.resource.data.ownerId.size() > 0
          && request.resource.data.representativeId == request.resource.data.ownerId
          && request.resource.data.ownershipVerified == true;

      allow update: if admin()
        || managerAdminPermission('manage_institutes')
        || (managerAdminPermission('ownership_claim_review')
          && (request.resource.data.status == resource.data.status
            || (resource.data.status in ['pending', 'verified'] && request.resource.data.status == 'approved'))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ownerId', 'representativeId', 'ownershipVerified', 'updatedAt', 'status'
          ]))
        || (signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.get('representativeId', '') == resource.data.get('representativeId', '')
          && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
          && request.resource.data.status == resource.data.status
          && (validInstituteScore(request.resource.data) || (request.resource.data.get('minScore', 0) == resource.data.get('minScore', 0) && request.resource.data.get('scoreScale', 'unspecified') == resource.data.get('scoreScale', 'unspecified')))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'type', 'subcategory', 'campus', 'country', 'province', 'district', 'city', 'area', 'board', 'town',
            'sector', 'address', 'description', 'website', 'applicationUrl',
            'submissionMode', 'eligibility', 'programs', 'programGroups', 'contact', 'minScore', 'scoreScale',
            'nextProgram', 'admissionStatus', 'admissionDeadline', 'feeRange',
            'entryTestRequired', 'imageUrl', 'facilities', 'updatedAt'
          ]));

      allow delete: if admin() || managerAdminPermission('manage_institutes');

      match /instituteReviews/{reviewId} {
        function validReview() {
          return request.resource.data.keys().hasOnly(['instituteId', 'userId', 'authorName', 'rating', 'text', 'updatedAt', 'published'])
            && request.resource.data.instituteId == instituteId
            && request.resource.data.userId == request.auth.uid
            && reviewId == request.auth.uid
            && request.resource.data.rating is int
            && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
            && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100
            && request.resource.data.text is string && request.resource.data.text.size() <= 1000
            && request.resource.data.updatedAt is timestamp
            && request.resource.data.updatedAt == request.time
            && request.resource.data.published == true
            && get(/databases/$(database)/documents/institutes/$(instituteId)).data.status in ['approved', 'verified'];
        }
        allow create, update: if signedIn() && validReview();
        allow delete: if (signedIn() && reviewId == request.auth.uid)
          || admin() || managerAdminPermission('manage_institutes');
      }

      match /educationRecords/{recordId} {
        // Enrollment history is profile data; institute staff may review pending records.
        allow read: if signedIn() && (request.auth.uid == resource.data.userId
          || canManageInstitute(instituteId));
        allow create: if request.resource.data.instituteId == instituteId
          && (educationStudentCreate(request.resource.data, request.resource.data.userId, recordId)
            || (exists(/databases/$(database)/documents/users/$(request.resource.data.userId)/educationRecords/$(recordId))
              && educationStudentUpdate(request.resource.data,
                get(/databases/$(database)/documents/users/$(request.resource.data.userId)/educationRecords/$(recordId)).data,
                request.resource.data.userId, recordId)))
          && getAfter(/databases/$(database)/documents/users/$(request.resource.data.userId)/educationRecords/$(recordId)).data == request.resource.data;
        allow update: if request.resource.data.instituteId == instituteId
          && (educationStudentUpdate(request.resource.data, resource.data, resource.data.userId, recordId)
            || educationReview(request.resource.data, resource.data))
          && educationMembershipMatches(request.resource.data)
          && getAfter(/databases/$(database)/documents/users/$(resource.data.userId)/educationRecords/$(recordId)).data == request.resource.data;
        allow delete: if signedIn() && request.auth.uid == resource.data.userId
          && getAfter(/databases/$(database)/documents/users/$(resource.data.userId)/educationRecords/$(recordId)).data.instituteId != instituteId;
      }

      match /educationMemberships/{recordId} {
        allow read: if signedIn() && (request.auth.uid == resource.data.userId
          || canManageInstitute(instituteId) || resource.data.educationStatus == 'completed'
          || (resource.data.educationStatus == 'current' && resource.data.verificationStatus == 'approved'));
        allow create, update: if signedIn()
          && request.resource.data.instituteId == instituteId
          && (request.auth.uid == request.resource.data.userId || canManageInstitute(instituteId))
          && request.resource.data.educationRecordId == recordId
          && request.resource.data == educationMembershipData(getAfter(/databases/$(database)/documents/users/$(request.resource.data.userId)/educationRecords/$(recordId)).data);
        allow delete: if signedIn() && request.auth.uid == resource.data.userId
          && getAfter(/databases/$(database)/documents/users/$(resource.data.userId)/educationRecords/$(recordId)).data.instituteId != instituteId;
      }

      match /studentAffiliations/{studentId} {
        function approvedInstitute() {
          return get(/databases/$(database)/documents/institutes/$(instituteId)).data.status in ['approved', 'verified'];
        }
        allow read: if signedIn() && (request.auth.uid == studentId || canManageInstitute(instituteId)
          || (resource.data.status == 'approved'
            && resource.data.keys().hasOnly(['studentId', 'instituteId', 'status', 'verifiedAt'])));
        allow create: if signedIn() && request.auth.uid == studentId
          && approvedInstitute()
          && request.resource.data.studentId == studentId
          && request.resource.data.instituteId == instituteId
          && request.resource.data.program is string && request.resource.data.program.size() > 0
          && request.resource.data.program.size() <= 160
          && request.resource.data.studentName is string && request.resource.data.studentName.size() <= 100
          && request.resource.data.status == 'pending'
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.keys().hasOnly(['studentId', 'studentName', 'instituteId', 'program', 'status', 'updatedAt']);
        allow update: if
          (signedIn() && request.auth.uid == studentId
            && approvedInstitute()
            && resource.data.status in ['pending', 'rejected', 'approved']
            && getAfter(/databases/$(database)/documents/users/$(studentId)).data.studentInstituteId == instituteId
            && getAfter(/databases/$(database)/documents/users/$(studentId)).data.studentProgram == request.resource.data.program
            && getAfter(/databases/$(database)/documents/users/$(studentId)).data.studentVerificationStatus == 'pending'
            && request.resource.data.status == 'pending'
            && request.resource.data.studentId == studentId
            && request.resource.data.instituteId == instituteId
            && request.resource.data.program is string && request.resource.data.program.size() > 0
            && request.resource.data.program.size() <= 160
            && request.resource.data.studentName is string && request.resource.data.studentName.size() <= 100
            && request.resource.data.updatedAt is timestamp
            && request.resource.data.keys().hasOnly(['studentId', 'studentName', 'instituteId', 'program', 'status', 'updatedAt']))
          || (canManageInstitute(instituteId)
            && resource.data.status == 'pending'
            && request.resource.data.status in ['approved', 'rejected']
            && request.resource.data.studentId == studentId
            && request.resource.data.instituteId == instituteId
            && (
              (request.resource.data.status == 'approved'
                && request.resource.data.verifiedAt is timestamp
                && request.resource.data.keys().hasOnly(['studentId', 'instituteId', 'status', 'verifiedAt']))
              || (request.resource.data.status == 'rejected'
                && request.resource.data.reviewedBy == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy']))
            )
          );
        allow delete: if signedIn() && ((request.auth.uid == studentId
            && (resource.data.status != 'approved'
              || (selectedAffiliationValid(getAfter(/databases/$(database)/documents/users/$(studentId)).data, studentId)
                && (getAfter(/databases/$(database)/documents/users/$(studentId)).data.studentInstituteId != instituteId
                  || getAfter(/databases/$(database)/documents/users/$(studentId)).data.studentProgram == ''))))
          || canManageInstitute(instituteId));
      }

      match /opportunities/{opportunityId} {
        function canManageOpportunity() {
          return signedIn() && (admin() || managerAdminPermission('manage_institutes')
            || get(/databases/$(database)/documents/institutes/$(instituteId)).data.ownerId == request.auth.uid);
        }
        function validOpportunity() {
          return request.resource.data.instituteId == instituteId
            && request.resource.data.published == true
            && request.resource.data.kind in ['admission', 'course', 'scholarship']
            && request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 200
            && get(/databases/$(database)/documents/institutes/$(instituteId)).data.status in ['approved', 'verified'];
        }
        allow create: if canManageOpportunity() && validOpportunity()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canManageOpportunity() && validOpportunity()
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if canManageOpportunity();
      }
    }

    match /instituteTypes/{typeId} {
      allow read: if true;
      allow create, update, delete: if admin() || managerAdminPermission('manage_institutes');
    }

    match /hostels/{hostelId} {
      function managerPermission(permission) {
        return signedIn()
          && exists(/databases/$(database)/documents/hostels/$(hostelId)/managers/$(request.auth.uid))
          && get(/databases/$(database)/documents/hostels/$(hostelId)/managers/$(request.auth.uid)).data.status == 'active'
          && get(/databases/$(database)/documents/hostels/$(hostelId)/managers/$(request.auth.uid)).data.permissions[permission] == true;
      }

      function validHostelRoomAt(rooms, index) {
        return rooms.size() <= index || (rooms[index] is map
          && rooms[index].totalBeds is int && rooms[index].totalBeds > 0
          && rooms[index].availableBeds is int && rooms[index].availableBeds >= 0
          && rooms[index].availableBeds <= rooms[index].totalBeds
          && rooms[index].rent is string && rooms[index].rent.matches('^[0-9]+([.][0-9]+)?$')
          && !rooms[index].rent.matches('^0+([.]0+)?$')
          && rooms[index].rentBasis in ['Per bed', 'Per room']
          && rooms[index].securityFee is string && rooms[index].securityFee.matches('^[0-9]+([.][0-9]+)?$')
          && rooms[index].roomCount is int && rooms[index].roomCount > 0);
      }
      function validStructuredHostel(data) {
        return (!('listingDetails' in data) || (data.listingDetails is map
          && data.listingDetails.publicPhone is bool
          && (data.listingDetails.publicPhone == true || data.phone == '')))
          && (!('rooms' in data) || !('listingDetails' in data) || (data.rooms is list && data.rooms.size() > 0 && data.rooms.size() <= 30
          && validHostelRoomAt(data.rooms, 0)
          && validHostelRoomAt(data.rooms, 1)
          && validHostelRoomAt(data.rooms, 2)
          && validHostelRoomAt(data.rooms, 3)
          && validHostelRoomAt(data.rooms, 4)
          && validHostelRoomAt(data.rooms, 5)
          && validHostelRoomAt(data.rooms, 6)
          && validHostelRoomAt(data.rooms, 7)
          && validHostelRoomAt(data.rooms, 8)
          && validHostelRoomAt(data.rooms, 9)
          && validHostelRoomAt(data.rooms, 10)
          && validHostelRoomAt(data.rooms, 11)
          && validHostelRoomAt(data.rooms, 12)
          && validHostelRoomAt(data.rooms, 13)
          && validHostelRoomAt(data.rooms, 14)
          && validHostelRoomAt(data.rooms, 15)
          && validHostelRoomAt(data.rooms, 16)
          && validHostelRoomAt(data.rooms, 17)
          && validHostelRoomAt(data.rooms, 18)
          && validHostelRoomAt(data.rooms, 19)
          && validHostelRoomAt(data.rooms, 20)
          && validHostelRoomAt(data.rooms, 21)
          && validHostelRoomAt(data.rooms, 22)
          && validHostelRoomAt(data.rooms, 23)
          && validHostelRoomAt(data.rooms, 24)
          && validHostelRoomAt(data.rooms, 25)
          && validHostelRoomAt(data.rooms, 26)
          && validHostelRoomAt(data.rooms, 27)
          && validHostelRoomAt(data.rooms, 28)
          && validHostelRoomAt(data.rooms, 29)
        ));
      }
      allow read: if resource.data.status == 'approved' || hostelOwner() || admin()
        || (signedIn() && exists(/databases/$(database)/documents/hostels/$(hostelId)/managers/$(request.auth.uid))
          && get(/databases/$(database)/documents/hostels/$(hostelId)/managers/$(request.auth.uid)).data.status == 'active');

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && validStructuredHostel(request.resource.data);

      allow update: if (admin()
        || (hostelOwner()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.status == resource.data.status
          && request.resource.data.isVerified == resource.data.isVerified
          && request.resource.data.isDemo == resource.data.isDemo
          && request.resource.data.reviewCount == resource.data.reviewCount
          && request.resource.data.ratingTotal == resource.data.ratingTotal
          && request.resource.data.rating == resource.data.rating
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name','city','area','type','gender','distance','price','securityFee',
            'roomType','availability','meals','ac','facilities','imageUrl','imageUrls',
            'description','phone','website','address','rooms','rules','listingDetails','updatedAt'
          ]))
        || (managerPermission('basicInfo')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','type','gender','description','updatedAt']))
        || (managerPermission('location')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['city','area','distance','address','updatedAt']))
        || (managerPermission('pricing')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['price','securityFee','roomType','updatedAt']))
        || (managerPermission('rooms')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rooms','updatedAt']))
        || (managerPermission('photos')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imageUrl','imageUrls','updatedAt']))
        || (managerPermission('facilities')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['facilities','meals','ac','updatedAt']))
        || (managerPermission('rules')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rules','updatedAt']))
        || (managerPermission('availability')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availability','updatedAt']))
        || (managerPermission('contact')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone','website','updatedAt']))
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewCount', 'ratingTotal', 'rating', 'updatedAt'])
          && request.resource.data.reviewCount is number
          && request.resource.data.ratingTotal is number
          && request.resource.data.rating is number
          && request.resource.data.reviewCount >= 0
          && request.resource.data.ratingTotal >= 0
          && request.resource.data.rating >= 0
          && request.resource.data.rating <= 5))
        && ((!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rooms','listingDetails','phone']))
          || validStructuredHostel(request.resource.data));

      allow delete: if admin() || hostelOwner();

      match /private/{documentId} {
        function mayEditContact() {
          return admin() || (signedIn()
            && getAfter(/databases/$(database)/documents/hostels/$(hostelId)).data.ownerId == request.auth.uid)
            || managerPermission('contact');
        }
        allow read: if admin() || (signedIn() && get(/databases/$(database)/documents/hostels/$(hostelId)).data.ownerId == request.auth.uid) || managerPermission('contact');
        allow create, update: if documentId == 'contact' && mayEditContact()
          && request.resource.data.keys().hasOnly(['phone','updatedAt']) && request.resource.data.phone is string;
        allow delete: if mayEditContact();
      }

      match /managers/{managerId} {
        function parentHostelOwner() {
          return signedIn()
            && get(/databases/$(database)/documents/hostels/$(hostelId)).data.ownerId == request.auth.uid;
        }
        allow read: if admin() || parentHostelOwner()
          || (signedIn() && managerId == request.auth.uid && resource.data.status == 'active');
        allow create: if parentHostelOwner()
          && request.resource.data.userId == managerId
          && request.resource.data.hostelId == hostelId
          && request.resource.data.status == 'active'
          && request.resource.data.permissions is map;
        allow update: if parentHostelOwner()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.hostelId == resource.data.hostelId
          && request.resource.data.permissions is map;
        allow delete: if parentHostelOwner();
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn()
          && reviewId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 2000;
        allow update, delete: if signedIn()
          && reviewId == request.auth.uid
          && resource.data.userId == request.auth.uid;
      }
    }
    match /instituteClaims/{claimId} {
      // Claim submission transactions must be able to check an absent document.
      allow get: if signedIn() && !exists(/databases/$(database)/documents/instituteClaims/$(claimId));
      allow create: if signedIn()
        && request.resource.data.representativeId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if admin()
        || managerAdminPermission('ownership_claim_review')
        || (signedIn() && resource.data.representativeId == request.auth.uid);
      allow update: if admin()
        || (managerAdminPermission('ownership_claim_review')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt'])
          && request.resource.data.status in ['approved','rejected']
          && request.resource.data.representativeId == resource.data.representativeId
          && request.resource.data.instituteId == resource.data.instituteId);
      allow delete: if admin();
    }

    match /hostelClaims/{claimId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.hostelId is string
        && request.resource.data.hostelId.size() > 0
        && request.resource.data.hostelName is string
        && request.resource.data.hostelName.size() > 0
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 100
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 2000;
      allow read: if admin() || managerAdminPermission('ownership_claim_review') || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if admin()
        || (managerAdminPermission('ownership_claim_review')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy'])
          && request.resource.data.status in ['approved','rejected']
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.hostelId == resource.data.hostelId);
      allow delete: if admin();
    }

    match /resources/{resourceId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.url is string
        && request.resource.data.url.matches('https?://.*')
        && request.resource.data.url.size() <= 2048
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 5000
        && request.resource.data.keys().hasOnly([
          'title', 'url', 'description', 'authorId', 'createdAt'
        ]);
      allow update: if admin()
        || (signedIn()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'url', 'description'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.url is string
          && request.resource.data.url.matches('https?://.*')
          && request.resource.data.url.size() <= 2048
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 5000);
      allow delete: if admin()
        || (signedIn() && resource.data.authorId == request.auth.uid);
    }
    match /reports/{reportId} {
      // Users may submit reports about content, but only admins can inspect or moderate them.
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetType is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 2000
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly([
          'reporterId', 'targetId', 'targetType', 'reason', 'createdAt', 'status'
        ]);
      allow read, update, delete: if admin();
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && mutualFollow(request.resource.data.participants[0], request.resource.data.participants[1])
        && notBlocked(request.resource.data.participants[0], request.resource.data.participants[1]);
      allow update: if signedIn()
        && isParticipant(resource.data.participants)
        && request.resource.data.participants == resource.data.participants
        && mutualFollow(resource.data.participants[0], resource.data.participants[1]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants)
          && notBlocked(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0],
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[1]);
        allow create: if signedIn()
          && isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.receiverId in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && mutualFollow(request.resource.data.senderId, request.resource.data.receiverId)
          && notBlocked(request.resource.data.senderId, request.resource.data.receiverId)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;
        allow update: if signedIn()
          && resource.data.receiverId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.receiverId == resource.data.receiverId
          && request.resource.data.text == resource.data.text
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow delete: if false;
      }
    }

    match /issueTickets/{ticketId} {
      function canManageIssueTickets() { return admin() || managerAdminPermission('manage_reports'); }
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid && request.resource.data.ticketNumber is string && request.resource.data.ticketNumber.size() > 0 && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120 && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 5000 && request.resource.data.category is string && request.resource.data.priority in ['Low','Medium','High'] && request.resource.data.status == 'open' && request.resource.data.keys().hasOnly(['ticketNumber','reporterId','reporterName','category','title','description','priority','status','screenshotUrl','latestReply','latestReplyBy','createdAt','updatedAt','lastActorUid']);
      allow read: if canManageIssueTickets() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow update: if canManageIssueTickets() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','latestReply','latestReplyBy','updatedAt','lastActorUid']) && request.resource.data.status in ['open','in_progress','resolved','closed'] && request.resource.data.latestReply is string && request.resource.data.latestReply.size() <= 2000 && request.resource.data.latestReplyBy is string && request.resource.data.lastActorUid == request.auth.uid;
      allow delete: if false;
      match /history/{eventId} {
        allow read: if canManageIssueTickets() || (signedIn() && get(/databases/$(database)/documents/issueTickets/$(ticketId)).data.reporterId == request.auth.uid);
        allow create: if signedIn() && request.resource.data.actorUid == request.auth.uid && request.resource.data.message is string && request.resource.data.message.size() <= 2000 && request.resource.data.eventType in ['created','status_changed','reply'] && ((getAfter(/databases/$(database)/documents/issueTickets/$(ticketId)).data.reporterId == request.auth.uid && request.resource.data.eventType == 'created' && request.resource.data.status == 'open') || canManageIssueTickets());
        allow update, delete: if false;
      }
    }
    match /helpFaqs/{faqId} { allow read: if true; allow create, update, delete: if admin() || managerAdminPermission('manage_faqs'); }
    match /pushTokens/{uid} { allow read: if admin() || managerAdminPermission('manage_reports') || (signedIn() && request.auth.uid == uid); allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.tokens is list && request.resource.data.adminRecipient is bool && request.resource.data.keys().hasOnly(['uid','tokens','adminRecipient','updatedAt']) && (request.resource.data.adminRecipient == false || admin() || managerAdminPermission('manage_reports')); allow delete: if (signedIn() && request.auth.uid == uid) || admin(); }
  }
}
