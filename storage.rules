rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /institutes/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && (request.auth.uid == userId || admin());
      allow delete: if signedIn() && (request.auth.uid == userId || admin());
    }

    match /hostels/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && (request.auth.uid == userId || admin());
      allow delete: if signedIn() && (request.auth.uid == userId || admin());
    }

    match /issueAttachments/{userId}/{ticketId}/{fileName} {
      function canManageIssueReports() { return signedIn() && (admin() || (firestore.get(/databases/(default)/documents/adminRoles/$(request.auth.uid)).data.status == 'active' && firestore.get(/databases/(default)/documents/adminRoles/$(request.auth.uid)).data.role == 'manager_admin' && firestore.get(/databases/(default)/documents/adminRoles/$(request.auth.uid)).data.permissions.manage_reports == true)); }
      allow read: if signedIn() && (request.auth.uid == userId || canManageIssueReports());
      allow create, update: if signedIn() && request.auth.uid == userId && request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if (signedIn() && request.auth.uid == userId) || admin();
    }
  }
}